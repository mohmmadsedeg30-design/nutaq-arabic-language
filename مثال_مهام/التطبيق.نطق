# نُطْق 0.3 — تطبيق مهام عربي كامل مع SQLite وواجهة JSON

دع قاعدة = افتح_قاعدة("بيانات/مهام.db")
قاعدة.نفذ("CREATE TABLE IF NOT EXISTS مهام (معرف INTEGER PRIMARY KEY AUTOINCREMENT, عنوان TEXT NOT NULL, مكتملة INTEGER NOT NULL DEFAULT 0)")

دالة مهام_HTML() {
    دع مهام = قاعدة.نفذ("SELECT معرف, عنوان, مكتملة FROM مهام ORDER BY معرف DESC")
    إذا طول(مهام) == 0 {
        أرجع "<li class=\"empty\">لا توجد مهام بعد. أضف أول مهمة.</li>"
    }

    دع HTML = ""
    لكل مهمة في مهام {
        دع حالة = "قيد التنفيذ"
        دع صنف_الحالة = "open"
        إذا مهمة.مكتملة == 1 {
            حالة = "مكتملة"
            صنف_الحالة = "done"
        }
        HTML = HTML + "<li class=\"task " + صنف_الحالة + "\" data-id=\"" + نص(مهمة.معرف) + "\">"
        HTML = HTML + "<span class=\"task-title\">" + هروب_HTML(مهمة.عنوان) + "</span>"
        HTML = HTML + "<span class=\"badge\">" + حالة + "</span>"
        HTML = HTML + "<button class=\"toggle\">تبديل الحالة</button>"
        HTML = HTML + "<button class=\"delete\">حذف</button></li>"
    }
    أرجع HTML
}

دالة الرئيسية(طلب) {
    أرجع صفحة(قالب("الرئيسية.html"، {
        "مهام": مهام_HTML(),
        "أصول": أصول_واجهة(),
        "زر_سمة": زر_سمة("تبديل الوضع")
    }))
}

دالة قائمة_المهام(طلب) {
    أرجع JSON({"مهام": قاعدة.نفذ("SELECT معرف, عنوان, مكتملة FROM مهام ORDER BY معرف DESC")})
}

دالة أنشئ_مهمة(طلب) {
    حاول {
        دع بيانات = طلب.بيانات
        إذا بيانات == عدم { ارم "أرسل JSON يحتوي على عنوان." }
        دع عنوان = بيانات.عنوان
        إذا طول(عنوان) == 0 أو طول(عنوان) > 120 { ارم "العنوان مطلوب ويجب ألا يتجاوز 120 حرفًا." }
        دع نتيجة = قاعدة.نفذ("INSERT INTO مهام (عنوان, مكتملة) VALUES (?, ?)", [عنوان، 0])
        أرجع JSON({"تم": صحيح، "معرف": نتيجة.معرف_أخير}، 201)
    } التقط خطأ {
        أرجع JSON({"تم": خطأ، "خطأ": خطأ.رسالة}، 400)
    }
}

دالة بدّل_الحالة(طلب) {
    حاول {
        دع معرف = عدد(طلب.معاملات.معرف)
        قاعدة.نفذ("UPDATE مهام SET مكتملة = 1 - مكتملة WHERE معرف = ?", [معرف])
        أرجع JSON({"تم": صحيح})
    } التقط خطأ {
        أرجع JSON({"تم": خطأ، "خطأ": خطأ.رسالة}، 400)
    }
}

دالة احذف_مهمة(طلب) {
    حاول {
        دع معرف = عدد(طلب.معاملات.معرف)
        قاعدة.نفذ("DELETE FROM مهام WHERE معرف = ?", [معرف])
        أرجع JSON({"تم": صحيح})
    } التقط خطأ {
        أرجع JSON({"تم": خطأ، "خطأ": خطأ.رسالة}، 400)
    }
}

ثابت("/static")
مسار("GET"، "/"، الرئيسية)
مسار("GET"، "/api/مهام"، قائمة_المهام)
مسار("POST"، "/api/مهام"، أنشئ_مهمة)
مسار("PATCH"، "/api/مهام/{معرف}"، بدّل_الحالة)
مسار("DELETE"، "/api/مهام/{معرف}"، احذف_مهمة)
شغّل(8000)
