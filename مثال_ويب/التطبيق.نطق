# متجر تجريبي كامل مكتوب بلغة نُطْق

دع المنتجات = [
    {"اسم": "حاسوب نُطْق", "وصف": "جهاز خفيف للمبرمجين العرب.", "سعر": 3499}،
    {"اسم": "دفتر أفكار", "وصف": "دفتر منظم لتخطيط المشاريع.", "سعر": 45}،
    {"اسم": "لوحة مفاتيح عربية", "وصف": "مفاتيح واضحة مع تخطيط عربي.", "سعر": 280}
]

دالة بطاقات_المنتجات() {
    دع HTML = ""
    لكل منتج في المنتجات {
        HTML = HTML + "<article class=\"card\">"
        HTML = HTML + "<h2>" + منتج["اسم"] + "</h2>"
        HTML = HTML + "<p>" + منتج["وصف"] + "</p>"
        HTML = HTML + "<strong>" + نص(منتج["سعر"]) + " ر.س</strong>"
        HTML = HTML + "</article>"
    }
    أرجع HTML
}

دالة الرئيسية(طلب) {
    دع سياق = {
        "عنوان": "نُطْق ويب",
        "وصف": "موقع ديناميكي كامل كُتب بلغة برمجة عربية.",
        "عدد": طول(المنتجات)،
        "بطاقات": بطاقات_المنتجات()
    }
    أرجع صفحة(قالب("الرئيسية.html"، سياق))
}

دالة واجهة_المنتجات(طلب) {
    أرجع JSON({"المنتجات": المنتجات، "العدد": طول(المنتجات)})
}

دالة منتج_واحد(طلب) {
    دع معرف = عدد(طلب["معاملات"]["معرف"])
    إذا معرف < 0 أو معرف >= طول(المنتجات) {
        أرجع JSON({"خطأ": "المنتج غير موجود"}، 404)
    }
    أرجع JSON(المنتجات[معرف])
}

دالة استقبال_رسالة(طلب) {
    إذا طلب["طريقة"] == "GET" {
        أرجع صفحة(قالب("تواصل.html"، {"عنوان": "تواصل معنا"}))
    }
    دع بيانات = طلب["بيانات"]
    إذا بيانات == عدم {
        أرجع JSON({"خطأ": "أرسل بيانات JSON أو نموذجًا صالحًا."}، 400)
    }
    أرجع JSON({"تم": صحيح، "رسالة": "وصلت رسالتك بنجاح."}، 201)
}

ثابت("/static")
مسار("GET"، "/"، الرئيسية)
مسار("GET"، "/api/المنتجات"، واجهة_المنتجات)
مسار("GET"، "/api/المنتجات/{معرف}"، منتج_واحد)
مسار("GET"، "/تواصل"، استقبال_رسالة)
مسار("POST"، "/تواصل"، استقبال_رسالة)
شغّل(8000)
