# برنامج طرفي عربي كامل بلغة نُطْق
# يعمل في Termux: python -m nutaq.cli أمثلة/دخول_طرفية.نطق

دالة توقف_مع_عد() {
    اطبع_يمين("تنبيه: كلمة المرور غير صحيحة. سيغلق البرنامج بعد 10 ثوانٍ."، "أحمر")
    لكل ثانية في نطاق(10، -1، -1) {
        اكتب(لوّن("المتبقي: " + نص(ثانية) + " ثانية ", ألوان.أصفر)، "\r")
        انتظر(1)
    }
    اطبع()
    اخرج(1)
}

امسح()
دع الاسم = أدخل_يمين(أخضر("من فضلك أدخل اسمك: "))
اطبع_يمين("مرحبًا " + الاسم + "، أهلاً بك في منصة نُطْق."، "أزرق")
انتظر(2)
امسح()

دع العمر = 0
حاول {
    العمر = عدد(أدخل_يمين(أخضر("أدخل عمرك لإكمال التسجيل: ")))
} التقط مشكلة {
    اطبع_يمين("العمر يجب أن يكون رقمًا صالحًا."، "أحمر")
    اخرج(1)
}

إذا العمر < 18 {
    اطبع_يمين("عذرًا، أنت دون سن 18 عامًا."، "أحمر")
    اخرج(1)
} وإلا {
    اطبع_يمين("أهلاً بك " + الاسم + "، يمكنك متابعة استخدام حسابك."، "أرجواني")
}

دع كلمة_المرور = أدخل_يمين(أخضر("أدخل كلمة المرور: "))
إذا كلمة_المرور == "Dagger123" {
    اطبع_يمين("كلمة المرور صحيحة. يمكنك المتابعة."، "أخضر")
} وإلا {
    توقف_مع_عد()
}

انتظر(3)
امسح()
دع كلمة = "خطأ  "
دع مرات = عدد(عرض_الطرفية() / طول(كلمة))
اطبع(أحمر(كرر(كلمة، مرات)))
