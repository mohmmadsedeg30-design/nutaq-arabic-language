# مثال متكامل بلغة نُطْق: تحليل درجات

دالة مجموع(عناصر) {
    دع الناتج = 0
    لكل عنصر في عناصر {
        الناتج = الناتج + عنصر
    }
    أرجع الناتج
}

دالة أعلى_درجة(عناصر) {
    دع الأعلى = عناصر[0]
    لكل عنصر في عناصر {
        إذا عنصر > الأعلى {
            الأعلى = عنصر
        }
    }
    أرجع الأعلى
}

دع الأسماء = ["سارة"، "ليان"، "عمر"، "كريم"]
دع الدرجات = [98، 91، 87، 95]
دع المتوسط = مجموع(الدرجات) / طول(الدرجات)

اطبع("تقرير الدرجات")
اطبع("--------------")
لكل فهرس في نطاق(طول(الأسماء)) {
    اطبع(الأسماء[فهرس] + ": " + نص(الدرجات[فهرس]))
}

اطبع("المتوسط: " + نص(المتوسط))
اطبع("أعلى درجة: " + نص(أعلى_درجة(الدرجات)))

إذا المتوسط >= 90 {
    اطبع("التقدير العام: ممتاز")
} وإلا إذا المتوسط >= 75 {
    اطبع("التقدير العام: جيد جدًا")
} وإلا {
    اطبع("التقدير العام: يحتاج إلى متابعة")
}
