# معرض مكتبة واجهة نُطْق 0.4

دالة بطاقات_القدرات() {
    دع بطاقة_ألوان = بطاقة(
        "ألوان متوازنة",
        "<p>نظام ألوان فاتح وداكن بمتغيرات CSS عربية، دون تثبيت أي إطار واجهات.</p>",
        شارة("خفيف جدًا"، "نجاح")
    )
    دع بطاقة_رموز = بطاقة(
        "أيقونات SVG",
        "<p class=\"icon-row\">" + أيقونة("منزل"، 28) + أيقونة("بحث"، 28) + أيقونة("مستخدم"، 28) + أيقونة("تحقق"، 28) + "</p>",
        شارة("دون صور"، "معلومات")
    )
    دع بطاقة_تفاعل = بطاقة(
        "تفاعل مدمج",
        "<p>نوافذ وتبويبات وتنبيهات قابلة للإغلاق وزر لتبديل السمة.</p>",
        زر_نافذة("عن_نطق"، "عرض التفاصيل")
    )
    أرجع "<div class=\"ن-شبكة ن-شبكة--3\">" + بطاقة_ألوان + بطاقة_رموز + بطاقة_تفاعل + "</div>"
}

دالة الرئيسية(طلب) {
    دع أقسام = تبويبات([
        {"عنوان": "السرعة"، "محتوى": "<p>كل الأصل البصري داخل الخادم: CSS وJavaScript صغيران ولا مكتبات CDN.</p>"}،
        {"عنوان": "الأمان"، "محتوى": "<p>النصوص في الأزرار والتنبيهات تهرب تلقائيًا من HTML.</p>"}،
        {"عنوان": "العربية"، "محتوى": "<p>أسماء المكوّنات والأيقونات والاتجاه الافتراضي مصممة للواجهة العربية.</p>"}
    ])
    دع نافذتي = نافذة("عن_نطق"، "عن مكتبة واجهة نُطْق"، "<p>هذه نافذة تفاعلية مدمجة. يمكنك إغلاقها بالزر أو مفتاح Escape.</p>")
    دع سياق = {
        "أصول": أصول_واجهة()،
        "زر_سمة": زر_سمة("تبديل الوضع"),
        "تنبيه": تنبيه("تم تحميل مكتبة الواجهة بنجاح.", "نجاح"),
        "بطاقات": بطاقات_القدرات(),
        "تبويبات": أقسام,
        "نافذة": نافذتي
    }
    أرجع صفحة(قالب("الرئيسية.html"، سياق))
}

مسار("GET"، "/"، الرئيسية)
شغّل(8000)
